VERCEL_ORIGIN=https://adchan-web.vercel.app
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adchan

LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Ask instead of routing when top confidence is below this value.
LLM_TOP_CONFIDENCE_THRESHOLD=0.70
# Ask instead of routing when top minus second confidence is below this value.
LLM_CONFIDENCE_GAP_THRESHOLD=0.15

SARVAM_API_KEY=
# Optional: gpt-4o-transcribe STT fallback only.
STT_FALLBACK_API_KEY=
